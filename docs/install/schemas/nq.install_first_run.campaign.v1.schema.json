{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unpingable/nq/docs/install/schemas/nq.install_first_run.campaign.v1.schema.json",
  "title": "NQ installation and first-run campaign result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "track",
    "profile",
    "dependency_mode",
    "started_at",
    "finished_at",
    "duration_ms",
    "time_to_first_profile_result_ms",
    "time_to_first_meaningful_host_result_ms",
    "blocker",
    "observations",
    "steps",
    "workspace_retained",
    "workspace",
    "raw_evidence_policy",
    "verdicts"
  ],
  "properties": {
    "schema": {
      "const": "nq.install_first_run.campaign.v1"
    },
    "status": {
      "enum": [
        "blocked",
        "installed_without_first_use",
        "profile_first_use_completed"
      ]
    },
    "track": {
      "enum": [
        "source-archive",
        "release"
      ]
    },
    "profile": {
      "enum": [
        "suite-minimal",
        "legacy-operational",
        "monitor-dashboard-only",
        "witness-artifact"
      ]
    },
    "dependency_mode": {
      "enum": [
        "isolated-offline",
        "isolated-online"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "time_to_first_profile_result_ms": {
      "$ref": "#/$defs/optionalDuration"
    },
    "time_to_first_meaningful_host_result_ms": {
      "$ref": "#/$defs/optionalDuration"
    },
    "blocker": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "code",
            "detail"
          ],
          "properties": {
            "phase": {
              "type": "string",
              "minLength": 1
            },
            "code": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "detail": {
              "type": "string"
            }
          }
        }
      ]
    },
    "observations": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "workspace_retained": {
      "type": "boolean"
    },
    "workspace": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_evidence_policy": {
      "type": "string",
      "minLength": 1
    },
    "verdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "self_contained",
        "composable",
        "recoverable",
        "suitable_for_non_author"
      ],
      "properties": {
        "self_contained": {
          "type": "boolean"
        },
        "composable": {
          "type": "boolean"
        },
        "recoverable": {
          "type": "boolean"
        },
        "suitable_for_non_author": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "optionalDuration": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "step_id",
        "description",
        "argv",
        "cwd",
        "started_at",
        "finished_at",
        "duration_ms",
        "exit_code",
        "timed_out",
        "stdin",
        "stdout",
        "stderr"
      ],
      "properties": {
        "schema": {
          "const": "nq.install_first_run.step.v1"
        },
        "step_id": {
          "type": "string",
          "pattern": "^[0-9]{3}-[a-z0-9-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "stdin": {
          "const": "null_device"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        }
      }
    }
  }
}
