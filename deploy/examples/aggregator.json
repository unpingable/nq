{
  "interval_s": 60,
  "db_path": "/var/lib/nq/nq.db",
  "bind_addr": "127.0.0.1:9848",

  "sources": [
    {
      "name": "my-host",
      "base_url": "http://127.0.0.1:9847",
      "timeout_ms": 10000
    }
  ],

  "retention": {
    "max_generations": 2880,
    "prune_every_n_cycles": 60
  },

  "notifications": {
    "channels": [],
    "min_severity": "warning",
    "external_url": "http://127.0.0.1:9848"
  },

  "liveness": {
    "path": "/var/lib/nq/liveness.json",
    "instance_id": "nq-central"
  }
}
