{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nq.dashboard.persona-corpus.v1.schema.json",
  "title": "NQ dashboard synthetic operator persona corpus",
  "type": "array",
  "minItems": 10,
  "maxItems": 10,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "archetype",
      "label",
      "expertise",
      "urgency",
      "trust_posture",
      "decision_needs",
      "constraints",
      "likely_behaviors",
      "brief"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]+$"
      },
      "archetype": {
        "type": "string",
        "enum": [
          "production_sre",
          "devops_engineer",
          "linux_systems_administrator",
          "database_operator",
          "junior_on_call",
          "incident_commander",
          "security_conscious_operator",
          "sleep_deprived_operator",
          "skeptical_evaluator",
          "domain_expert_unfamiliar_with_nq"
        ]
      },
      "label": {
        "type": "string",
        "minLength": 3
      },
      "expertise": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "string",
          "minLength": 2
        }
      },
      "urgency": {
        "type": "string",
        "enum": [
          "routine",
          "time_bounded",
          "outage",
          "fatigued"
        ]
      },
      "trust_posture": {
        "type": "string",
        "enum": [
          "pragmatic",
          "cautious",
          "instruction_following",
          "adversarial",
          "skeptical"
        ]
      },
      "decision_needs": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "string",
          "minLength": 3
        }
      },
      "constraints": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 3
        }
      },
      "likely_behaviors": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "string",
          "minLength": 3
        }
      },
      "brief": {
        "type": "string",
        "minLength": 40
      }
    }
  }
}
